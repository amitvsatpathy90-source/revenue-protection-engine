<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone module by design (ADR-15 §3.1): NOT aggregated by the core pom.
         Module deletion = full rollback; the core build never sees Spring AI.
         Build: mvn -f rpe-triage-agent/pom.xml verify -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.rpe</groupId>
    <artifactId>rpe-triage-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rpe-triage-agent</name>
    <description>Advisory AI triage downstream of payment.alerts — ADR-15. Never gates detection or delivery.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring AI is not in the Boot BOM — pin explicitly -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Same Resilience4j line as core; wired manually (no global defaults) -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- One version for all six manually-wired resilience4j modules -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ── Single MVC + virtual-threads surface (ADR-15 §3.9 — NO WebFlux here) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging (RPE-13): masked event_id/account_id + trace/span ids become
             first-class aggregator fields (the alert_id/MDC cross-service join, security.md). Not in
             the Boot BOM — pin explicitly (compatible with Boot 4.1's logback 1.5.x). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>

        <!-- ── Distributed tracing (ADR-25): Micrometer Observation → OTel bridge → OTLP.
             The triage consumer auto-continues the trace from the payment.alerts traceparent
             header; Spring AI 2.0's observation-aware OpenAI model contributes the LLM span
             (gen_ai conventions) for free. BOM-managed versions; fail-open. ── -->
        <!-- Boot 4 split: the Tracer-bridge + OTel SDK autoconfig live in this starter; the
             micrometer bridge artifact alone does not bring Boot's autoconfig. With it present,
             Spring AI's observation-aware model also emits the gen_ai LLM span. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Zero-trust Actuator surface: OAuth2 Resource Server (ADR-19) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ── Spring AI: ChatModel + @Tool + structured output (LangChain4j rejected, ADR-15 §4) ── -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- ── Kafka: consume payment.alerts, produce payment.alerts.triaged ── -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Boot 4.1 split: KafkaProperties moved from spring-boot-autoconfigure →
             spring-boot-kafka (not transitive via spring-kafka; must be declared) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- ── JDBC + Postgres: triaged_alerts inbox + read-only processed_alerts tool ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Boot 4.1 split: FlywayAutoConfiguration moved to spring-boot-flyway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ── Redis: read-only account-history tool (blocking Lettuce on VTs — fine, parks) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Boot 4.1 dual-Jackson world: Jackson 2.x ObjectMapper bean (Spring Kafka uses
             Jackson 2.x; spring-boot-jackson2 provides the com.fasterxml ObjectMapper) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- ── Resilience4j: full stack on the LLM boundary (ADR-15 §3.6).
             Versions managed by the resilience4j-bom import above. ── -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-timelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-ratelimiter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>

        <!-- ── Config metadata ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════ TEST — all provider interaction stubbed; no live calls in verify ══════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: cross-service import + silent-failure guards (ADR-17 §7 Stage 4) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
