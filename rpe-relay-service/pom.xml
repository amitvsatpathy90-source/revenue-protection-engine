<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone service by design (ADR-17 §3.5): NOT aggregated by the core pom.
         Build: mvn -f rpe-relay-service/pom.xml verify
         Owns: the outbox READER + status-transition contract (PENDING → PUBLISHED/FAILED)
               + the purge_old_records() schedule. Sole writer of outbox ROWS is detection.
         No Redis, no WebFlux, no Kafka consumer — a DB-reader / Kafka-transactional-producer. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.rpe</groupId>
    <artifactId>rpe-relay-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rpe-relay-service</name>
    <description>Exactly-once delivery: outbox → payment.alerts, Kafka-transactional. ADR-17 service #2.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- ── Web (Tomcat): keeps JVM alive + serves actuator (ADR-17 §3.5).
             Without a web server, all relay threads are daemon VTs and the JVM
             exits immediately after startup when run as a standalone JAR. ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Actuator + Prometheus (own health/metrics surface, ADR-17 §3.5) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging (RPE-13): masked event_id/account_id + trace/span ids become
             first-class aggregator fields (the alert_id/MDC cross-service join, security.md). Not in
             the Boot BOM — pin explicitly (compatible with Boot 4.1's logback 1.5.x). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>

        <!-- ── Distributed tracing (ADR-25): Micrometer Observation → OTel bridge → OTLP.
             The relay RESTORES the outbox row's persisted W3C traceparent as the remote parent,
             so its payment.alerts produce span continues the originating event's trace across the
             durable-queue gap. BOM-managed versions; fail-open. ── -->
        <!-- Boot 4 split: the Tracer-bridge + OTel SDK autoconfig live in this starter; the
             micrometer bridge artifact alone does not bring Boot's autoconfig (no Tracer bean
             without it — and AlertPublisher injects Tracer/Propagator). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Zero-trust Actuator surface: OAuth2 Resource Server (ADR-19) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ── Kafka: transactional producer ONLY (no consumer — reads outbox from DB) ── -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Boot 4 split: KafkaProperties lives in spring-boot-kafka (ADR-16) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- ── JDBC + Postgres: reads outbox, transitions status, LISTEN/NOTIFY ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- ── Flyway: DISABLED in prod (relay owns no tables; reads detection's outbox
             contract). Present so the relay's own integration test can provision the
             outbox contract DDL in its ephemeral Postgres (spring.flyway.enabled=true
             in the test profile only). ── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ── Jackson 2.x ObjectMapper: relay reads outbox.payload as opaque JsonNode
             (ADR-11) and republishes it byte-identically (spring-boot-jackson2, ADR-16) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ── Reactor: relay loop hops JDBC onto the platform-thread jdbcScheduler
             (Mono.subscribeOn). No reactive Redis, no WebFlux. ── -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- ── Config metadata ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════ TEST ══════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit: same subscribe(onError)/no-synchronized guards as core (rules §7) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
