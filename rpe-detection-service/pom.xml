<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.rpe</groupId>
    <artifactId>rpe-detection-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rpe-detection-service</name>
    <description>Ingest + atomic Lua-gate detection + outbox writer + HTTP surface. ADR-17 service #1 (the indivisible
        detection core).
    </description>

    <properties>
        <java.version>21</java.version>
        <guava.version>33.6.0-jre</guava.version>
        <archunit.version>1.5.0</archunit.version>
        <blockhound.version>1.0.17.RELEASE</blockhound.version>
        <!-- Resilience4j is not in the Spring Boot BOM — pin explicitly -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>

    <dependencies>

        <!-- ── HTTP surface: WebFlux (Netty) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging (RPE-13): masked event_id/account_id + trace/span ids become
             first-class aggregator fields (the alert_id/MDC cross-service join, security.md). Not in
             the Boot BOM — pin explicitly (compatible with Boot 4.1's logback 1.5.x). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>

        <!-- ── Redis: reactive Lettuce — does not pin VTs ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- ── Kafka ── -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Boot 4.0 split: KafkaProperties moved from spring-boot-autoconfigure →
             spring-boot-kafka (not transitive via spring-kafka; must be declared) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- Boot 4.0 dual-Jackson world: spring-boot-jackson creates tools.jackson.JsonMapper
             (Jackson 3.x); spring-boot-jackson2 creates com.fasterxml.jackson.ObjectMapper
             (Jackson 2.x). Spring Kafka 4.x still uses Jackson 2.x internally, so our
             injection points must use the Jackson 2.x bean from spring-boot-jackson2. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- Boot 4.0 split: FlywayAutoConfiguration moved from spring-boot-autoconfigure →
             spring-boot-flyway (not transitive via spring-boot-starter-jdbc; must be declared) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Required for Spring Boot condition annotations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- ── JDBC + Postgres: platform-thread pool only ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- ── Flyway (Flyway 10 requires DB-specific artifact for PG) ── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ── Resilience4j: CB + Bulkhead + Reactor integration ── -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- ── Caffeine: lane map + rate-limiter cache ── -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ── Guava: RateLimiter ── -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <!-- ── Validation ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ── Zero-trust Actuator surface: OAuth2 Resource Server (ADR-19) ──
             The only HTTP surface in the system is the Actuator; every call validates a JWT
             (signature+issuer+audience+scope) except the detail-free k8s probes. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ── Micrometer context-propagation: required for
             Hooks.enableAutomaticContextPropagation() to bridge MDC across reactive
             thread hops. Without it the hook is a silent no-op and log correlation
             (masked event_id/account_id) is lost past the first publishOn. ── -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <!-- ── Distributed tracing (ADR-25): Micrometer Observation → OTel bridge → OTLP.
             App-level, NOT the k8s OTel Java agent: only in-code instrumentation can carry
             trace context across the outbox durable-queue seam (the agent sees the INSERT and
             the relay's SELECT as two unrelated ops). Versions BOM-managed by Spring Boot 4.1.
             Fail-open: a down/absent collector drops spans, never blocks detection.
             Boot 4 split: the OTel SDK + Tracer-bridge auto-config live in the
             spring-boot-starter-opentelemetry module (the micrometer bridge artifact alone does
             NOT bring Boot's autoconfig — there is no Tracer bean without the starter). ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Jackson: explicit for JsonNode (AlertIntent outbox payload) ── -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ── Config metadata ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════ TEST ══════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Redis via GenericContainer -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @Testcontainers + @Container annotations (JUnit 5 extension) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-security-test: reactive mockJwt() for the actuator authz integration test (ADR-19) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit: enforces subscribe(onNext, onError) rule -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- BlockHound: compile scope so DevConfig can call BlockHound.install() at runtime
             (dev profile, controlled by rpe.dev.blockhound.enabled). Excluded from the
             repackaged boot jar — dev runs use spring-boot:run (classpath, not the jar). -->
        <dependency>
            <groupId>io.projectreactor.tools</groupId>
            <artifactId>blockhound</artifactId>
            <version>${blockhound.version}</version>
        </dependency>
        <!-- Reactor Tools: ReactorDebugAgent (dev-only activation via config).
             Compile scope: DevConfig imports it. Excluded from the repackaged boot jar. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-tools</artifactId>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- Dev-only diagnostics stay on the compile classpath for spring-boot:run,
                                 but are excluded from the repackaged boot jar. -->
                            <excludes>
                                <exclude>
                                    <groupId>io.projectreactor.tools</groupId>
                                    <artifactId>blockhound</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>io.projectreactor</groupId>
                                    <artifactId>reactor-tools</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Dev profile: activates dev Spring profile + VT pinning trace JVM arg -->
    <profiles>
        <profile>
            <id>dev</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <profiles>dev</profiles>
                            <jvmArguments>-Djdk.tracePinnedThreads=full</jvmArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
