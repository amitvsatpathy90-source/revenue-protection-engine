# Copy to .env and fill in values. Never commit .env.

POSTGRES_PASSWORD=rpe_dev
DB_URL=jdbc:postgresql://localhost:5432/rpe
DB_USER=rpe
DB_PASSWORD=rpe_dev

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Per-instance relay identity — must be unique across relay instances.
# Docker: set to ${HOSTNAME}. Kubernetes: set to $(POD_NAME) via downward API.
# Two relay instances sharing the same ID -> ProducerFencedException loop (ADR-06).
RELAY_INSTANCE_ID=relay-dev-1

GRAFANA_PASSWORD=grafana_dev

# ── Kafka transport auth (ADR-20) — SASL_SSL/SCRAM, one principal per service ──
# PLAINTEXT for local lab (Redpanda); SASL_SSL in prod/k8s. Services are fail-closed:
# a SASL_* protocol with missing creds aborts startup (never silently PLAINTEXT).
RPE_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
RPE_KAFKA_SECURITY_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TRUSTSTORE_LOCATION=
KAFKA_TRUSTSTORE_PASSWORD=

# ACL provisioning (deploy/kafka/provision-acls.sh): admin principal + per-service passwords
KAFKA_ADMIN_BROKERS=
KAFKA_ADMIN_USER=
KAFKA_ADMIN_PASSWORD=
KAFKA_PW_DETECTION=
KAFKA_PW_RELAY=
KAFKA_PW_ALERT=
KAFKA_PW_TRIAGE=

# ── Zero-trust Actuator auth (ADR-19) — every service is an OAuth2 Resource Server ──
# Services FAIL TO START without issuer + JWKS (fail-closed, same discipline as DB_PASSWORD).
# Lab: the static JWKS stub (deploy/oauth/generate-jwks.sh once; the jwks-stub compose service
# serves it). Prod: point both at your real IdP. The issuer is an exact-string match against the
# token's `iss` claim — it must equal mint-jwt.sh's --iss (default below), and it never varies
# with vantage. The JWKS URI does: in-network containers resolve `jwks-stub`; HOST-run services
# (`mvn spring-boot:run`) use http://localhost:9001/.well-known/jwks.json instead.
RPE_OAUTH_ISSUER=http://rpe-jwks-stub
RPE_OAUTH_JWKS_URI=http://jwks-stub/.well-known/jwks.json
RPE_OAUTH_AUDIENCE=rpe-actuator

# Prometheus scrape bearer (lab: static token file; prod: oauth2 client_credentials).
# Mint (30d): RPE_PROM_SCRAPE_TOKEN=$(deploy/oauth/mint-jwt.sh --ttl 2592000)
RPE_PROM_SCRAPE_TOKEN=

# ── Triage agent (ADR-15, optional — compose profile "triage") ──
# Leave empty to run in designed degraded mode (DEGRADED_RULE_BASED verdicts).
# Set a provider-side hard monthly cap before using a real key (ADR-15 §5.2).
SPRING_AI_OPENAI_API_KEY=llm-disabled-sentinel

# Per-instance LLM calls/minute — the billing breaker (effective global = N x per_instance)
TRIAGE_LLM_RPM=30
