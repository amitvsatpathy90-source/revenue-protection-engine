{
  "id": null,
  "uid": "rpe-prod-overview",
  "title": "RPE Production Operations & Domain Dashboard",
  "refresh": "10s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 100,
      "title": "Core Service Health (RED Framework)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "DLT Active vs Parked Queues",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "sum(rpe_dlt_depth{job=~\"rpe-.*\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "background" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx Error Rate",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=~\"rpe-.*\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=~\"rpe-.*\"}[$__rate_interval]))) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 5,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.5 }
            ]
          },
          "noValue": "0%"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP Request Latency (p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"rpe-.*\", uri!~\".*/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "p99 Execution"
        },
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"rpe-.*\", uri!~\".*/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "p95 Execution"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 200,
      "title": "Infrastructure & State Isolation (USE Framework)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "id": 4,
      "title": "Kafka Consumer Ingestion Lag",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "sum by (topic) (kafka_consumergroup_lag{job=~\"rpe-.*\", topic=~\"rpe-.*\"})",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 15 }
        }
      }
    },
    {
      "id": 5,
      "title": "Redis Memory Utilization & Evictions",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "(max by (job) (rpe_redis_used_memory_bytes{job=~\"rpe-.*\"}) / max by (job) (rpe_redis_maxmemory_bytes{job=~\"rpe-.*\"})) * 100",
          "legendFormat": "Memory Utilization %"
        },
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "rate(rpe_redis_evicted_keys_total{job=~\"rpe-.*\"}[$__rate_interval])",
          "legendFormat": "Evictions (keys/sec)"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      }
    },
    {
      "id": 6,
      "title": "Resilience4j Circuit Breaker Timeline",
      "type": "state-timeline",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "name": "Prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "name": "Prometheus" },
          "expr": "resilience4j_circuitbreaker_state{job=~\"rpe-.*\", state=\"closed\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "options": { "showValue": "never", "mergeValues": true }
    }
  ]
}