<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone service by design (ADR-17 §3.5): NOT aggregated by the core pom.
         Build: mvn -f rpe-alert-service/pom.xml verify
         Owns: processed_alerts (sole writer). Consumes payment.alerts (read_committed),
               idempotent INSERT ON CONFLICT DO NOTHING (deterministic UUIDv5 alert_id).
         No Redis, no transactional producer — a Kafka consumer + JDBC writer. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.rpe</groupId>
    <artifactId>rpe-alert-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rpe-alert-service</name>
    <description>Idempotent alert actioning: payment.alerts → processed_alerts. ADR-17 service #3.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- ── Web (Tomcat): keeps JVM alive + serves actuator HTTP (liveness/readiness probes).
             Without this, all consumer threads are daemon VTs; the JVM exits on startup
             and port 8083 never binds — k8s liveness probe kills the pod. ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ── Actuator + Prometheus (own health/metrics surface, ADR-17 §3.5) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Structured JSON logging (RPE-13): masked event_id/account_id + trace/span ids become
             first-class aggregator fields (the alert_id/MDC cross-service join, security.md). Not in
             the Boot BOM — pin explicitly (compatible with Boot 4.1's logback 1.5.x). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>

        <!-- ── Distributed tracing (ADR-25): Micrometer Observation → OTel bridge → OTLP.
             The alert consumer auto-continues the trace from the payment.alerts traceparent
             header (relay-injected), so processed_alerts actioning lands in the same trace.
             BOM-managed versions; fail-open. ── -->
        <!-- Boot 4 split: the Tracer-bridge + OTel SDK autoconfig live in this starter; the
             micrometer bridge artifact alone does not bring Boot's autoconfig (no Tracer/exporter
             wiring without it). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ── Zero-trust Actuator surface: OAuth2 Resource Server (ADR-19) ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ── Kafka: consume payment.alerts; DLT producer for payment.alerts.DLT ── -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>

        <!-- ── JDBC + Postgres: owns processed_alerts ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- ── Flyway: owns the processed_alerts migration. Separate history table
             (flyway_schema_history_alert) so it never corrupts the detection service's
             migration state on the shared DB (same discipline as the triage module). ── -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ── Jackson 2.x ObjectMapper bean (Spring Kafka 2.x JsonDeserializer; test
             message building). spring-boot-jackson2 per ADR-16. ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- ── Reactor: AlertConsumer hops the processed_alerts INSERT onto the
             platform-thread jdbcScheduler (Mono.subscribeOn). ── -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- ── Config metadata ── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════ TEST ══════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
